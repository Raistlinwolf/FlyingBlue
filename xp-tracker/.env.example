# Copy to .env.local for local development. Never commit real values.
#
# The app is a static site. It asks for the Supabase URL + publishable key on its
# Connect screen and stores them in the browser, so these are only *defaults*.
#
# Local Supabase (npx supabase start → npx supabase status):
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# NEVER put the secret / service-role key here — it would be public in the build.

# Sub-path when hosted on GitHub Pages (set by the deploy workflow). Leave empty locally.
# NEXT_PUBLIC_BASE_PATH=/FlyingBlue
